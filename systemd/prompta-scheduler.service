[Unit]
Description=Prompta durable scheduler producer
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Slice=prompta.slice
Type=simple
WorkingDirectory=%h/prompta
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_PROGRESS=1
ExecStart=%h/prompta/.venv/bin/prompta-scheduler
Restart=always
RestartSec=3
WatchdogSec=30s
NotifyAccess=main
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/prompta %h/.config/prompta
MemoryHigh=256M
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=prompta.target
