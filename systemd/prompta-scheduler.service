[Unit]
Description=Prompta durable scheduler producer
After=network-online.target

[Service]
Slice=prompta.slice
Type=simple
WorkingDirectory=%h/prompta
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_PROGRESS=1
ExecStart=%h/prompta/.venv/bin/prompta-scheduler
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/prompta %h/.config/prompta
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=default.target
