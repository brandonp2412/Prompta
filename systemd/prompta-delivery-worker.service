[Unit]
Description=Prompta durable delivery worker
Wants=network-online.target prompta-browser.service
After=network-online.target prompta-browser.service
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Slice=prompta.slice
Type=simple
WorkingDirectory=%h/prompta
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_PROGRESS=1
Environment=PROMPTA_CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222
Environment=PROMPTA_FLARESOLVERR_URL=http://127.0.0.1:8191
ExecStart=%h/prompta/.venv/bin/prompta-delivery-worker
Restart=always
RestartSec=3
WatchdogSec=45s
NotifyAccess=main
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/prompta %h/.config/prompta
MemoryHigh=512M
MemoryMax=1G
TasksMax=512

[Install]
WantedBy=prompta.target
