[Unit]
Description=Prompta durable delivery worker
Wants=prompta.service
After=network-online.target prompta.service

[Service]
Slice=prompta.slice
Type=simple
WorkingDirectory=%h/prompta
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_PROGRESS=1
ExecStart=%h/prompta/.venv/bin/prompta-delivery-worker
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/prompta %h/.config/prompta
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=default.target
