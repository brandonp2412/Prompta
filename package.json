{
  "name": "prompta-ui",
  "private": true,
  "type": "module",
  "dependencies": {
    "@preact/signals-core": "^1.12.0",
    "@preact/signals-react": "^3.2.0",
    "marked": "^16.4.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "build": "vite build && bun scripts/normalize-bundle.mjs src/static/app.js",
    "fmt": "bun x oxfmt src/ui vite.config.ts",
    "fmt:check": "bun x oxfmt --check src/ui vite.config.ts",
    "lint": "bun x oxlint --deny-warnings --type-aware --type-check -D no-nested-ternary src/ui && bun run lint:dom",
    "lint:dom": "bun scripts/lint-react-dom.mjs && node --test tests/lintReactDom.test.mjs",
    "typecheck": "bun x tsgo -p tsconfig.tests.json --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run build",
    "test": "bun test tests/*.test.ts && bun test --preload ./tests/setup-dom.ts tests/*.test.tsx && node --test tests/*.test.cjs tests/*.test.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "bun-types": "^1.4.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  },
  "packageManager": "bun@1.4.0"
}
