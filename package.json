{
  "name": "prompta-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && bun scripts/normalize-bundle.mjs src/static/app.js",
    "fmt": "bun x oxfmt src/ui vite.config.ts svelte.config.js",
    "fmt:check": "bun x oxfmt --check src/ui vite.config.ts svelte.config.js",
    "lint": "bun x oxlint --deny-warnings --type-aware --type-check src/ui",
    "typecheck": "bun x tsgo -p tsconfig.json --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run check:svelte && bun run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "bun-types": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  },
  "packageManager": "bun@1.4.0"
}
